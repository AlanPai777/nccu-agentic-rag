# Copy this file to .env and fill in your keys.
# .env is gitignored — never commit actual keys.

# ── Provider selection ────────────────────────────────────────────────────────
# Switch between Ollama cloud and OpenRouter:
#   LLM_PROVIDER=ollama       (default)
#   LLM_PROVIDER=openrouter
LLM_PROVIDER=ollama

# ── Ollama cloud ──────────────────────────────────────────────────────────────
# 1. Sign in: ollama signin   OR create API key at https://ollama.com/settings/keys
# 2. Pull model (optional for cloud):  ollama pull gemma4:31b-cloud
# Docs: https://ollama.com/blog/cloud
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gemma4:31b-cloud

# ── OpenRouter ────────────────────────────────────────────────────────────────
# Get API key at: https://openrouter.ai/settings/keys
# Free models: https://openrouter.ai/models?q=free
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# ── LangFuse tracing (agentic_rag.py — optional) ──────────────────────────────
# Self-hosted local instance (docker compose up in a cloned langfuse repo):
#   1. Open http://localhost:3000, sign up (local account, not synced anywhere)
#   2. Create an Organization, then a Project
#   3. Project → Settings → API Keys → Create new API key
#   4. Paste the Public/Secret key below (Secret Key is shown only once)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=http://localhost:3000
